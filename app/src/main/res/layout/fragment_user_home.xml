<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- SIÊU CARD GIỚI THIỆU -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFeatured"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/imgFeatured"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_pod_placeholder" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#80000000" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="bottom|start"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvFeaturedName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A103"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvFeaturedType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meeting Room"
                        android:textSize="16sp"
                        android:textColor="#E0F7FA"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvFeaturedPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="200.000đ/giờ"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#2DF836"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvViewMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem chi tiết >"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_rounded_white"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2 NÚT -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btUrBooking"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Đơn của bạn"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FDFDFD"
                android:backgroundTint="#000000"
                app:cornerRadius="28dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintTop_toBottomOf="@id/cardFeatured"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnSearchRooms" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearchRooms"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Tìm Phòng"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:strokeColor="#000000"
                app:strokeWidth="2dp"
                android:textColor="#000000"
                android:backgroundTint="@android:color/transparent"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="@id/btUrBooking"
                app:layout_constraintStart_toEndOf="@id/btUrBooking"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- TIÊU ĐỀ + DANH SÁCH -->
            <TextView
                android:id="@+id/tvFeatured"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Văn phòng nổi bật"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toBottomOf="@id/btUrBooking"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFeaturedPods"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvFeatured"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang tải..."
                android:textSize="16sp"
                android:textColor="#888888"
                android:layout_marginTop="40dp"
                app:layout_constraintTop_toBottomOf="@id/rvFeaturedPods"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>