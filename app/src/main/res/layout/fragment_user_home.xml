<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8F9FA"
        >

        <!-- ScrollView để cuộn khi nội dung dài -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- === PHẦN GIỚI THIỆU APP === -->
                <LinearLayout
                    android:id="@+id/headerSection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:layout_marginTop="20px"
                    android:background="@drawable/bg_gradient_intro"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="POD Booking System"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đặt văn phòng pod riêng tư\nChỉ 1 chạm!"
                        android:textSize="16sp"
                        android:textColor="#E0F7FA"
                        android:layout_marginTop="8dp"
                        android:gravity="center" />

                    <!-- Nút Booking Ngay -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBookNow"
                        android:layout_width="200dp"
                        android:layout_height="56dp"
                        android:text="Booking Ngay"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:backgroundTint="#FFFFFF"
                        app:cornerRadius="28dp"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        android:layout_marginTop="20dp"
                        android:elevation="8dp" />

                </LinearLayout>

                <FrameLayout
                    android:id="@+id/mapSection"
                    android:layout_width="414dp"
                    android:layout_height="65dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/headerSection">

                    <!-- Ảnh nền bản đồ -->
                    <ImageView
                        android:id="@+id/imgMapBackground"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/map_background" />

                    <!-- Lớp phủ mờ -->
                    <View
                        android:id="@+id/overlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#80000000" /> <!-- 50% mờ đen -->

                    <!-- Nút “Đến với chúng tôi” -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNavigate"
                        android:layout_width="220dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:backgroundTint="#2196F3"
                        android:elevation="8dp"
                        android:text="Đến với chúng tôi"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="26dp" />
                </FrameLayout>
                <!-- === Ô TÌM KIẾM === -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/searchBox"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="Tìm văn phòng"
                    android:layout_marginTop="24dp"
                    app:startIconTint="#3C3C3C"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeColor="#3C3C3C"
                    app:hintTextColor="#3C3C3C"
                    app:layout_constraintTop_toBottomOf="@id/mapSection"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- === TIÊU ĐỀ DANH SÁCH === -->
                <TextView
                    android:id="@+id/tvFeatured"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Văn phòng nổi bật"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginTop="32dp"
                    app:layout_constraintTop_toBottomOf="@id/searchBox"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- === RecyclerView (sẽ thêm sau) === -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFeaturedPods"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@id/tvFeatured"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:listitem="@layout/item_pod_card" />

                <!-- Placeholder khi chưa có data -->
                <TextView
                    android:id="@+id/tvPlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang tải văn phòng hot..."
                    android:textSize="16sp"
                    android:textColor="#888888"
                    android:layout_marginTop="40dp"
                    app:layout_constraintTop_toBottomOf="@id/rvFeaturedPods"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>