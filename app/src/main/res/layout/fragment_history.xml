<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true"
    tools:context=".fragments.admin_fragments.HistoryFragment">

    <!-- Tiêu đề -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Booking History"
        android:textSize="24sp"
        android:gravity="center"
        android:textStyle="bold"
        android:paddingVertical="16dp"
        android:textColor="#1A5276" />

    <!-- Khu vực tìm kiếm & lọc -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="5dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <!-- Ô tìm kiếm -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Tìm theo tên phòng hoặc người đặt..."
            android:padding="10dp"
            android:background="@drawable/bg_search_box"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="6dp"
            android:inputType="text"
            android:textSize="14sp" />

        <!-- Nút chọn ngày -->
        <TextView
            android:id="@+id/tvDateFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn ngày"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_filter_button"
            android:textSize="14sp"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btnClearFilter"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Bỏ lọc"
            android:layout_marginStart="6dp"
            app:backgroundTint="@null"
            android:background="@drawable/bg_button_secondary"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- Danh sách lịch sử đặt phòng -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBookingHistory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="8dp"
        android:clipToPadding="false"
        android:layout_marginBottom="8dp" />
</LinearLayout>
