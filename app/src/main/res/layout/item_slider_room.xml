<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_margin="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <ImageView
        android:id="@+id/imgSliderBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_pod_placeholder" />

    <!-- Lớp tối để chữ nổi -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom|start"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvSliderRoomName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A103"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvSliderRoomType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meeting Room"
            android:textSize="14sp"
            android:textColor="#E0F7FA"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvSliderPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="200.000đ/giờ"
            android:textColor="#4CAF50"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>